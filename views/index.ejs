<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SAMP-TOOLS VERNOZ v5.0</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #070a12;
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.12) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(6, 182, 212, 0.12) 0px, transparent 50%);
            background-attachment: fixed;
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #0d1322; }
        ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #334155; }

        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .dropzone-active {
            border-color: #06b6d4 !important;
            background-color: rgba(6, 182, 212, 0.15) !important;
        }

        #sidebar { transition: transform 0.3s ease-in-out; }

        pre, code {
            white-space: pre-wrap !important;
            word-break: break-all !important;
            overflow-x: auto !important;
        }
    </style>
</head>
<body class="font-sans text-slate-200 min-h-screen flex flex-col justify-between p-3 sm:p-6 md:p-8 selection:bg-cyan-500 selection:text-black">

    <!-- OVERLAY SIDEBAR BACKGROUND -->
    <div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden transition-opacity"></div>

    <!-- SIDEBAR NAVIGATION DRAWER -->
    <aside id="sidebar" class="fixed top-0 left-0 h-full w-72 bg-slate-900/95 border-r border-slate-800 z-50 transform -translate-x-full p-6 flex flex-col justify-between shadow-2xl glass-panel">
        <div>
            <div class="flex items-center justify-between pb-6 border-b border-slate-800">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-terminal text-cyan-400 text-xl"></i>
                    <span class="font-bold text-white text-base tracking-wide">SAMP-TOOLS VERNOZ</span>
                </div>
                <button onclick="toggleSidebar()" class="text-slate-400 hover:text-white p-2 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <nav class="mt-6 space-y-1.5">
                <button onclick="selectTool('check')" id="nav-check" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                    <i class="fa-solid fa-shield-halved text-lg"></i> 1. Cek & Scan Lua
                </button>
                <button onclick="selectTool('obfuscate')" id="nav-obfuscate" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-slate-400 hover:bg-slate-800/60 hover:text-white">
                    <i class="fa-solid fa-lock text-lg"></i> 2. Obfuscator Lua
                </button>
                <button onclick="selectTool('ssrp')" id="nav-ssrp" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-slate-400 hover:bg-slate-800/60 hover:text-white">
                    <i class="fa-solid fa-camera text-lg"></i> 3. SSRP Maker / Chat RP
                </button>
                <button onclick="selectTool('vehskin')" id="nav-vehskin" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-slate-400 hover:bg-slate-800/60 hover:text-white">
                    <i class="fa-solid fa-car text-lg"></i> 4. Vehicle & Skin DB
                </button>
                <button onclick="selectTool('anim')" id="nav-anim" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-slate-400 hover:bg-slate-800/60 hover:text-white">
                    <i class="fa-solid fa-person-running text-lg"></i> 5. AnimList Finder
                </button>
                <button onclick="selectTool('weapon')" id="nav-weapon" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-slate-400 hover:bg-slate-800/60 hover:text-white">
                    <i class="fa-solid fa-gun text-lg"></i> 6. Weapon & Damage Calc
                </button>
                <button onclick="selectTool('bypass')" id="nav-bypass" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-slate-400 hover:bg-slate-800/60 hover:text-white">
                    <i class="fa-solid fa-link-slash text-lg text-purple-400"></i> 7. Bypass Link Shortener
                </button>
                <button onclick="selectTool('client')" id="nav-client" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-slate-400 hover:bg-slate-800/60 hover:text-white">
                    <i class="fa-brands fa-android text-lg text-emerald-400"></i> 8. Client Android
                </button>
                <button onclick="selectTool('credit')" id="nav-credit" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-slate-400 hover:bg-slate-800/60 hover:text-white">
                    <i class="fa-solid fa-circle-info text-lg"></i> 9. Credit & Info
                </button>
            </nav>
        </div>

        <div class="text-xs text-slate-500 text-center border-t border-slate-800 pt-4">
            SAMP-TOOLS VERNOZ &bull; v5.0
        </div>
    </aside>

    <!-- CONTAINER UTAMA -->
    <div class="max-w-6xl mx-auto w-full overflow-hidden">
        
        <!-- HEADER TOPBAR -->
        <header class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-3 bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/80 text-cyan-400 rounded-2xl shadow-lg transition flex items-center gap-2">
                    <i class="fa-solid fa-bars text-xl"></i>
                    <span class="text-xs font-bold text-slate-200 hidden sm:inline">Menu Tools</span>
                </button>

                <div>
                    <h1 class="text-xl sm:text-2xl font-extrabold text-white flex items-center gap-2">
                        <span id="tool-title-header" class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-indigo-400 to-purple-500">SAMP-TOOLS VERNOZ</span>
                    </h1>
                </div>
            </div>

            <span class="text-xs font-mono px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-400">
                <i class="fa-solid fa-code-commit text-cyan-400 mr-1"></i> v5.0
            </span>
        </header>

        <!-- TOOL 1: CEK SYNTAX & KEAMANAN LUA -->
        <div id="tool-check" class="glass-panel rounded-3xl p-4 sm:p-6 md:p-8 shadow-2xl">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                <div>
                    <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-cyan-400"></i> Auto Live Scanner & Security Detector
                    </h2>
                    <p class="text-slate-400 text-xs sm:text-sm">Tarik & lepas file `.lua` ke area editor atau ketik langsung untuk pemindaian otomatis.</p>
                </div>
                
                <label class="cursor-pointer inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-cyan-300 transition shadow-md">
                    <i class="fa-solid fa-file-arrow-up text-cyan-400"></i> Pilih File .LUA
                    <input type="file" id="file-picker-check" accept=".lua,.txt" class="hidden">
                </label>
            </div>
            
            <div id="dropzone-check" class="relative rounded-2xl overflow-hidden border-2 border-dashed border-slate-700/80 focus-within:border-cyan-500 transition-all bg-slate-950/80">
                <textarea id="lua-check-input" oninput="onInputCheck()" rows="12" class="w-full bg-transparent p-4 text-cyan-100 font-mono text-xs sm:text-sm focus:outline-none resize-y placeholder-slate-600 leading-relaxed" placeholder="-- Masukkan kode Lua di sini..."></textarea>
                <div class="bg-slate-900/90 border-t border-slate-800/80 px-4 py-2 flex items-center justify-between text-xs text-slate-400 font-mono">
                    <span id="check-stats"><i class="fa-regular fa-file-code mr-1"></i> 0 Baris | 0 Karakter</span>
                    <button onclick="clearCheckArea()" class="hover:text-red-400 transition"><i class="fa-solid fa-trash-can mr-1"></i> Bersihkan</button>
                </div>
            </div>

            <div id="check-result" class="hidden mt-6 space-y-3"></div>
        </div>

        <!-- TOOL 2: OBFUSCATOR LUA -->
        <div id="tool-obfuscate" class="hidden glass-panel rounded-3xl p-4 sm:p-6 md:p-8 shadow-2xl">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                <div>
                    <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-lock text-indigo-400"></i> Lua Bytecode Encrypter
                    </h2>
                    <p class="text-slate-400 text-xs sm:text-sm">Enkripsi kode Lua kamu agar aman dari decompile atau pencurian karya.</p>
                </div>

                <label class="cursor-pointer inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-indigo-300 transition shadow-md">
                    <i class="fa-solid fa-file-arrow-up text-indigo-400"></i> Pilih File .LUA
                    <input type="file" id="file-picker-obf" accept=".lua,.txt" class="hidden">
                </label>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-400 mb-2">Kode Asli (Source)</label>
                    <div id="dropzone-obf" class="rounded-2xl overflow-hidden border-2 border-dashed border-slate-700/80 focus-within:border-indigo-500 transition-all bg-slate-950/80">
                        <textarea id="lua-obf-input" oninput="updateStats('obf')" rows="12" class="w-full bg-transparent p-4 text-slate-200 font-mono text-xs sm:text-sm focus:outline-none resize-y placeholder-slate-600 leading-relaxed" placeholder="-- Ketik atau tempel kode Lua asli..."></textarea>
                        <div class="bg-slate-900/90 border-t border-slate-800/80 px-4 py-2 text-xs text-slate-400 font-mono">
                            <span id="obf-stats"><i class="fa-regular fa-file-code mr-1"></i> 0 Baris</span>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase text-slate-400 mb-2">Hasil Obfuscated (Protected)</label>
                    <div class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-950">
                        <textarea id="lua-obf-output" readonly rows="12" class="w-full bg-transparent p-4 text-emerald-400 font-mono text-xs sm:text-sm focus:outline-none resize-y placeholder-slate-700 leading-relaxed" placeholder="Hasil terenkripsi muncul di sini..."></textarea>
                        <div class="bg-slate-900/90 border-t border-slate-800/80 px-4 py-2 flex items-center justify-between text-xs text-slate-400 font-mono">
                            <span>Status: Ready</span>
                            <span class="text-emerald-400"><i class="fa-solid fa-check-double mr-1"></i> Moonloader / Monetloader</span>
                        </div>
                    </div>
                </div>
            </div>

            <div id="obf-status" class="hidden mt-4"></div>

            <div class="mt-6 flex flex-col sm:flex-row justify-between items-center gap-3">
                <button onclick="obfuscateLua()" class="w-full sm:w-auto px-6 py-3 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white font-bold rounded-xl transition shadow-lg shadow-indigo-500/25 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Encrypt Sekarang
                </button>
                <button onclick="copyOutput('lua-obf-output')" class="w-full sm:w-auto px-6 py-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-bold rounded-xl transition flex items-center justify-center gap-2">
                    <i class="fa-regular fa-copy"></i> Salin Hasil Kode
                </button>
            </div>
        </div>

        <!-- TOOL 3: SSRP MAKER / CHAT RP GENERATOR -->
        <div id="tool-ssrp" class="hidden glass-panel rounded-3xl p-4 sm:p-6 md:p-8 shadow-2xl">
            <div class="mb-6">
                <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-camera text-purple-400"></i> SSRP Maker & Auto Chat RP Generator
                </h2>
                <p class="text-slate-400 text-xs sm:text-sm">Unggah gambar screenshot GTA SA-MP milikmu dan buat teks RP otomatis tanpa ribet.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <div class="lg:col-span-5 space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-400 mb-2">1. Upload Gambar Screenshot</label>
                        <input type="file" id="ssrp-img-input" accept="image/*" onchange="loadSSRPImage(event)" class="w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-slate-800 file:text-purple-300 hover:file:bg-slate-700 bg-slate-950 p-2 rounded-2xl border border-slate-800 cursor-pointer">
                    </div>

                    <div class="p-4 bg-slate-950 rounded-2xl border border-slate-800 space-y-3">
                        <span class="block text-xs font-bold text-purple-400 uppercase">2. Pengaturan Teks Roleplay</span>
                        
                        <div>
                            <label class="block text-[10px] uppercase text-slate-400 mb-1">Nama Character / Player</label>
                            <input type="text" id="ssrp-char-name" value="Ramzyy" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-xl text-white text-xs font-mono focus:outline-none focus:border-purple-500">
                        </div>

                        <div>
                            <label class="block text-[10px] uppercase text-slate-400 mb-1">Teks Chat / Aksi RP</label>
                            <input type="text" id="ssrp-text-input" placeholder="Contoh: halo" class="w-full bg-slate-900 border border-slate-700 p-3 rounded-xl text-white text-xs font-mono focus:outline-none focus:border-purple-500">
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] uppercase text-slate-400 mb-1">Tipe Command</label>
                                <select id="ssrp-type-select" onchange="applySSRPTypePreset()" class="w-full bg-slate-900 border border-slate-700 p-2 rounded-xl text-white text-xs font-semibold">
                                    <option value="me">/me (Otomatis *)</option>
                                    <option value="do">/do (Otomatis (( Nama )))</option>
                                    <option value="talk">Chat Biasa (Otomatis says:)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase text-slate-400 mb-1">Warna Hex</label>
                                <div class="flex items-center gap-2">
                                    <input type="color" id="ssrp-color-picker" value="#C2A2DA" class="w-8 h-8 rounded-lg bg-transparent cursor-pointer border-0">
                                    <input type="text" id="ssrp-color-hex" value="#C2A2DA" class="w-full bg-slate-900 border border-slate-700 p-2 rounded-xl text-white text-xs font-mono uppercase">
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] uppercase text-slate-400 mb-1">Ukuran Font: <span id="lbl-font-size">16</span>px</label>
                                <input type="range" id="ssrp-font-size" min="12" max="28" value="16" oninput="document.getElementById('lbl-font-size').innerText=this.value; renderSSRP();" class="w-full accent-purple-500">
                            </div>
                            <div class="flex items-center pt-3">
                                <label class="inline-flex items-center gap-2 cursor-pointer text-xs text-slate-300">
                                    <input type="checkbox" id="ssrp-font-bold" checked onchange="renderSSRP()" class="w-4 h-4 rounded accent-purple-500">
                                    Teks Tebal (Bold)
                                </label>
                            </div>
                        </div>

                        <button onclick="addSSRPLine()" class="w-full py-2.5 bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-lg shadow-purple-600/30">
                            <i class="fa-solid fa-plus"></i> Tambahkan Baris SSRP
                        </button>
                    </div>

                    <div>
                        <span class="block text-xs font-bold text-slate-400 uppercase mb-2">Daftar Baris Teks Terpasang</span>
                        <div id="ssrp-lines-list" class="space-y-2 max-h-48 overflow-y-auto pr-1">
                            <div class="text-xs text-slate-500 italic">Belum ada baris teks ditambahkan.</div>
                        </div>
                    </div>

                    <div class="p-3 bg-slate-950 rounded-2xl border border-slate-800 space-y-2 text-xs">
                        <span class="font-bold text-slate-400">Posisi Teks pada Gambar:</span>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="text-[10px] text-slate-400">Posisi X (Kiri/Kanan):</label>
                                <input type="range" id="ssrp-pos-x" min="10" max="100" value="20" oninput="renderSSRP()" class="w-full accent-purple-500">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400">Posisi Y (Atas/Bawah):</label>
                                <input type="range" id="ssrp-pos-y" min="20" max="500" value="40" oninput="renderSSRP()" class="w-full accent-purple-500">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-7 flex flex-col items-center">
                    <span class="block text-xs font-bold uppercase text-slate-400 mb-2 w-full">Hasil Preview SSRP</span>
                    <div class="w-full overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 p-2 flex justify-center items-center">
                        <canvas id="ssrp-canvas" class="max-w-full h-auto rounded-xl shadow-2xl"></canvas>
                    </div>

                    <div class="mt-4 w-full flex justify-end">
                        <button onclick="downloadSSRP()" class="px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold rounded-xl text-xs transition shadow-lg shadow-purple-500/25 flex items-center gap-2">
                            <i class="fa-solid fa-download"></i> Unduh Gambar SSRP
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOOL 4: VEHICLE & SKIN ID VISUAL DATABASE -->
        <div id="tool-vehskin" class="hidden glass-panel rounded-3xl p-4 sm:p-6 md:p-8 shadow-2xl">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-car text-cyan-400"></i> Vehicle & Skin ID Visual Database
                    </h2>
                    <p class="text-slate-400 text-xs sm:text-sm">Database lengkap 212 Kendaraan (ID 400–611) & Skin Karakter. Klik kartu untuk menyalin ID!</p>
                </div>

                <div class="flex bg-slate-950 p-1.5 rounded-2xl border border-slate-800 text-xs font-bold shadow-inner">
                    <button id="btn-tab-veh" onclick="switchVehSkinTab('veh')" class="px-5 py-2.5 rounded-xl bg-cyan-500 text-black shadow-md transition-all flex items-center gap-2">
                        <i class="fa-solid fa-car-side"></i> Kendaraan (212)
                    </button>
                    <button id="btn-tab-skin" onclick="switchVehSkinTab('skin')" class="px-5 py-2.5 rounded-xl text-slate-400 hover:text-white transition-all flex items-center gap-2">
                        <i class="fa-solid fa-user-ninja"></i> Skin Character
                    </button>
                </div>
            </div>

            <div class="space-y-3 mb-6">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-slate-500 text-sm"></i>
                    <input type="text" id="vehskin-search" oninput="filterVehSkinData()" placeholder="Cari ID atau Nama (contoh: 411, Infernus, Sultan, NRG-500)..." class="w-full bg-slate-950 border border-slate-800 rounded-2xl pl-11 pr-12 py-3 text-white text-xs sm:text-sm font-mono focus:outline-none focus:border-cyan-500 shadow-inner">
                    <span id="vehskin-counter" class="absolute right-4 top-3.5 text-[10px] font-mono text-cyan-400 font-bold bg-cyan-500/10 px-2 py-0.5 rounded-md border border-cyan-500/20">0 Data</span>
                </div>

                <div id="veh-category-pills" class="flex items-center gap-1.5 overflow-x-auto pb-2 text-[11px] font-semibold">
                    <button onclick="setVehCategory('ALL')" class="veh-cat-btn px-3 py-1.5 rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 whitespace-nowrap">Semua Kategori</button>
                    <button onclick="setVehCategory('Sports')" class="veh-cat-btn px-3 py-1.5 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 hover:text-white whitespace-nowrap">Sports</button>
                    <button onclick="setVehCategory('Saloon')" class="veh-cat-btn px-3 py-1.5 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 hover:text-white whitespace-nowrap">Saloon / Sedan</button>
                    <button onclick="setVehCategory('Motorbike')" class="veh-cat-btn px-3 py-1.5 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 hover:text-white whitespace-nowrap">Motorbike</button>
                    <button onclick="setVehCategory('Off-Road')" class="veh-cat-btn px-3 py-1.5 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 hover:text-white whitespace-nowrap">Off-Road</button>
                    <button onclick="setVehCategory('Public Service')" class="veh-cat-btn px-3 py-1.5 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 hover:text-white whitespace-nowrap">Police & Service</button>
                    <button onclick="setVehCategory('Industrial')" class="veh-cat-btn px-3 py-1.5 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 hover:text-white whitespace-nowrap">Industrial</button>
