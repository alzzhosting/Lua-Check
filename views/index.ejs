        async function checkLua() {
            const code = document.getElementById('lua-check-input').value;
            const resultBox = document.getElementById('check-result');
            if (!code.trim()) { resultBox.classList.add('hidden'); return; }

            try {
                const response = await fetch('/api/check-lua', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code })
                });
                const data = await response.json();
                resultBox.classList.remove('hidden');

                if (data.syntaxValid) {
                    resultBox.innerHTML = `<div class="p-4 rounded-2xl bg-emerald-950/70 border border-emerald-500/40 text-emerald-200 text-xs sm:text-sm">✓ Sintaks Lua Valid! Tidak ditemukan error.</div>`;
                } else {
                    resultBox.innerHTML = `<div class="p-4 rounded-2xl bg-red-950/80 border border-red-500/40 text-red-200 text-xs sm:text-sm font-mono">✕ ${data.syntaxError}</div>`;
                }
            } catch (err) {
                resultBox.classList.remove('hidden');
                resultBox.innerHTML = `<div class="p-4 rounded-2xl bg-red-950/80 border border-red-500/40 text-red-300 text-xs sm:text-sm">✕ Gagal terhubung ke server backend.</div>`;
            }
        }

