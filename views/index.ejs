        // SSRP MAKER LOGIC
        function initSSRPCanvas() {
            const canvas = document.getElementById('ssrp-canvas');
            canvas.width = 800;
            canvas.height = 450;
            renderSSRP();

            document.getElementById('ssrp-color-picker').addEventListener('input', (e) => {
                document.getElementById('ssrp-color-hex').value = e.target.value.toUpperCase();
            });
            document.getElementById('ssrp-color-hex').addEventListener('input', (e) => {
                let val = e.target.value;
                if (!val.startsWith('#')) val = '#' + val;
                if (val.length === 7) document.getElementById('ssrp-color-picker').value = val;
            });
        }

        function applySSRPTypePreset() {
            const type = document.getElementById('ssrp-type-select').value;
            const picker = document.getElementById('ssrp-color-picker');
            const hex = document.getElementById('ssrp-color-hex');

            if (type === 'me' || type === 'do') {
                picker.value = '#C2A2DA';
                hex.value = '#C2A2DA';
            } else {
                picker.value = '#FFFFFF';
                hex.value = '#FFFFFF';
            }
        }

        function loadSSRPImage(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    ssrpImage = img;
                    const canvas = document.getElementById('ssrp-canvas');
                    canvas.width = img.width;
                    canvas.height = img.height;
                    
                    document.getElementById('ssrp-pos-y').max = img.height;
                    document.getElementById('ssrp-pos-x').max = img.width;
                    
                    renderSSRP();
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function addSSRPLine() {
            const textInput = document.getElementById('ssrp-text-input');
            const charNameInput = document.getElementById('ssrp-char-name');
            const rawText = textInput.value.trim();
            const charName = charNameInput.value.trim() || 'Character';
            const type = document.getElementById('ssrp-type-select').value;
            const color = document.getElementById('ssrp-color-hex').value;
            const size = parseInt(document.getElementById('ssrp-font-size').value);
            const isBold = document.getElementById('ssrp-font-bold').checked;

            if (!rawText) return;

            let formattedText = rawText;

            if (type === 'me') {
                if (!rawText.startsWith('*')) formattedText = `* ${charName} ${rawText}`;
            } else if (type === 'do') {
                if (!rawText.includes('((')) formattedText = `${rawText} (( ${charName} ))`;
            } else if (type === 'talk') {
                if (!rawText.toLowerCase().includes('says:')) formattedText = `${charName} says: ${rawText}`;
            }

            ssrpLines.push({ text: formattedText, color, size, isBold });
            textInput.value = '';
            
            updateSSRPLinesList();
            renderSSRP();
        }

        function removeSSRPLine(index) {
            ssrpLines.splice(index, 1);
            updateSSRPLinesList();
            renderSSRP();
        }

        function updateSSRPLinesList() {
            const container = document.getElementById('ssrp-lines-list');
            if (ssrpLines.length === 0) {
                container.innerHTML = `<div class="text-xs text-slate-500 italic">Belum ada baris teks ditambahkan.</div>`;
                return;
            }

            container.innerHTML = ssrpLines.map((line, idx) => `
                <div class="flex items-center justify-between p-2 bg-slate-950 rounded-xl border border-slate-800 text-xs font-mono">
                    <span style="color: ${line.color};">${line.text}</span>
                    <button onclick="removeSSRPLine(${idx})" class="text-red-400 hover:text-red-300 p-1"><i class="fa-solid fa-xmark"></i></button>
                </div>
            `).join('');
        }

        function renderSSRP() {
            const canvas = document.getElementById('ssrp-canvas');
            const ctx = canvas.getContext('2d');

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (ssrpImage) {
                ctx.drawImage(ssrpImage, 0, 0, canvas.width, canvas.height);
            } else {
                ctx.fillStyle = '#0f172a';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = '#475569';
                ctx.font = 'bold 18px "Plus Jakarta Sans", sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('Unggah Gambar Screenshot untuk Menampilkan Background', canvas.width / 2, canvas.height / 2);
                ctx.textAlign = 'left';
            }

            const startX = parseInt(document.getElementById('ssrp-pos-x').value);
            let currentY = parseInt(document.getElementById('ssrp-pos-y').value);

            ssrpLines.forEach(line => {
                const fontWeight = line.isBold ? 'bold' : 'normal';
                ctx.font = `${fontWeight} ${line.size}px Tahoma, Arial, sans-serif`;

                ctx.strokeStyle = 'black';
                ctx.lineWidth = 3;
                ctx.lineJoin = 'miter';
                ctx.miterLimit = 2;
                ctx.strokeText(line.text, startX, currentY);

                ctx.fillStyle = line.color;
                ctx.fillText(line.text, startX, currentY);

                currentY += line.size + 6;
            });
        }

        function downloadSSRP() {
            const canvas = document.getElementById('ssrp-canvas');
            const link = document.createElement('a');
            link.download = 'ssrp-samp-' + Date.now() + '.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        }

        function copyOutput(elementId) {
            const el = document.getElementById(elementId);
            const text = el.value || el.innerText;
            if (!text) return;
            navigator.clipboard.writeText(text);
            alert('✓ Kode berhasil disalin!');
        }
    </script>
</body>
</html>
