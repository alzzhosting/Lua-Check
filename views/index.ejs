        // CALCULATE DAMAGE
        function calculateDamage() {
            const select = document.getElementById('calc-weapon-select');
            const baseDmg = parseFloat(select.options[select.selectedIndex].getAttribute('data-dmg'));
            const hp = parseFloat(document.getElementById('calc-hp').value) || 0;
            const arm = parseFloat(document.getElementById('calc-arm').value) || 0;
            const bodyPartMult = parseFloat(document.getElementById('calc-body-part').value);
            const shots = parseInt(document.getElementById('calc-shots').value) || 1;

            const totalDmg = baseDmg * bodyPartMult * shots;
            let sisaArm = arm - totalDmg;
            let sisaHp = hp;

            if (sisaArm < 0) { sisaHp += sisaArm; sisaArm = 0; }
            if (sisaHp < 0) sisaHp = 0;

            document.getElementById('res-total-dmg').innerText = totalDmg.toFixed(1);
            document.getElementById('res-sisa-arm').innerText = sisaArm.toFixed(1);
            document.getElementById('res-sisa-hp').innerText = sisaHp.toFixed(1);
        }

